<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+. No include/exclude rules = default behaviour: the app data (the alarm settings
    database) goes to cloud backup and to device-to-device transfer, so a new phone keeps the alarm.
    Nothing here is secret: the API key lives in the APK, not in app data.
-->
<data-extraction-rules>
    <cloud-backup />
    <device-transfer />
</data-extraction-rules>
